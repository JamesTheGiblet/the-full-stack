# Keys and secrets — never in this tree
*.key
*.pem
*.seed
*_secret*
*private*
.env
.env.*
keys/
secrets/

# Key material stored inside JSON. The rules above match by extension, so
# they never caught consumer/minecraft-main/.../chronoscribe/
# ed25519_keypair.json — a real Ed25519 private key that sat in this public
# repository from the first commit until it was untracked. Match the
# filename shape too, not just the extension.
*keypair*.json
*keypair*.ndjson

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
.offline-markdown-preview/

# Build output
dist/
build/
*.log
