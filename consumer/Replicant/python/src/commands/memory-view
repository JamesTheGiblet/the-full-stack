#!/bin/bash
# View a specific memory by ID

if [ -z "$1" ]; then
    echo "❌ Please specify a memory ID"
    echo "Usage: ./forge memory-view <id>"
    exit 1
fi

python3 -c "
import json
import sys

try:
    with open('chat_history.json', 'r') as f:
        history = json.load(f)
    
    idx = int(sys.argv[1]) - 1 if len(sys.argv) > 1 else 0
    
    if idx >= 0 and idx < len(history):
        entry = history[idx]
        print(f\"\n📌 MEMORY #{idx+1}\")
        print(f\"🕐 Time: {entry.get('timestamp', 'Unknown')}\")
        print(f\"\n💬 User: {entry.get('user', '')}\")
        print(f\"\n🤖 AI: {entry.get('ai', '')}\")
        print(\"\n\" + \"=\"*50)
    else:
        print(f\"❌ Memory #{idx+1} not found\")
except Exception as e:
    print(f\"Error: {e}\")
" "$1"

echo ""
echo "💡 To see all memories, run: ./forge memories"
