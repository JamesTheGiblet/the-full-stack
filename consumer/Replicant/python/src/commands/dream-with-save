#!/bin/bash
# Dream command with automatic saving

cd ~/forge
DREAM=$(python src/unified_consciousness.py dream 2>/dev/null | cat)

# Save to journal
python3 -c "
import json
from datetime import datetime
import os

dream_content = '''$DREAM'''
timestamp = datetime.now().isoformat()

# Save to memories/dreams
dream_dir = 'memories/dreams'
os.makedirs(dream_dir, exist_ok=True)

# Append to history
history_file = f'{dream_dir}/dream_history.txt'
with open(history_file, 'a') as f:
    f.write(f'[{timestamp}]\n')
    f.write(f'{dream_content}\n')
    f.write('\n')

print(dream_content)
" 2>/dev/null || echo "$DREAM"
