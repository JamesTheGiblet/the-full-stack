import sqlite3
import json
from collections import Counter

conn = sqlite3.connect("forge_data.db")
cursor = conn.cursor()

# Get all repos with topics
cursor.execute('SELECT name, topics, description FROM github_repos WHERE topics IS NOT NULL AND topics != "[]"')
repos = cursor.fetchall()

# Extract all topics
all_topics = []
topic_repo_count = {}

for name, topics_json, desc in repos:
    topics = json.loads(topics_json) if topics_json else []
    for topic in topics:
        all_topics.append(topic)
        topic_repo_count[topic] = topic_repo_count.get(topic, 0) + 1

# Count pattern keywords in descriptions
pattern_keywords = {
    'exponential decay': 0,
    'emergence': 0,
    'simulation': 0,
    'decay': 0,
    'pharmacokinetic': 0,
    'behavioral': 0,
    'security': 0,
    'visualization': 0
}

cursor.execute('SELECT description, name FROM github_repos WHERE description IS NOT NULL')
for desc, name in cursor.fetchall():
    desc_lower = desc.lower()
    for pattern in pattern_keywords:
        if pattern in desc_lower:
            pattern_keywords[pattern] += 1

print("📊 PATTERN FREQUENCY:")
print("-" * 40)
for pattern, count in sorted(pattern_keywords.items(), key=lambda x: x[1], reverse=True):
    if count > 0:
        print(f"  {pattern}: {count} repos")

print("\n🏷️ TOP TOPICS:")
